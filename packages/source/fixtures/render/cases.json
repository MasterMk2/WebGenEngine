  {"name": "invalid page language", "source": "", "page": {"title": "x", "lang": "ja\"><script>"}, "renderError": {"code": "E_LANG", "key": "lang"}},
  {"name": "default stylesheet", "stylesheet": "default.css"},
  {"name": "every class the schema can produce has a rule", "classCoverage": true},
  {"name": "theme: missing token", "themePatch": {"space": {"md": null}}, "renderError": {"code": "E_THEME", "key": "space.md"}},
  {"name": "theme: unknown color", "themePatch": {"color": {"accent": "#ff0000"}}, "renderError": {"code": "E_THEME", "key": "color.accent"}},
  {"name": "theme: length with a space", "themePatch": {"space": {"lg": "2 rem"}}, "renderError": {"code": "E_THEME", "key": "space.lg"}},
  {"name": "theme: length with a trailing line break", "themePatch": {"width": {"wide": "80rem\n"}}, "renderError": {"code": "E_THEME", "key": "width.wide"}},
  {"name": "theme: calc is not allowed", "themePatch": {"space": {"xs": "calc(1px + 1px)"}}, "renderError": {"code": "E_THEME", "key": "space.xs"}},
  {"name": "theme: named color", "themePatch": {"color": {"primary": "red"}}, "renderError": {"code": "E_THEME", "key": "color.primary"}},
  {"name": "theme: CSS injection through the font", "themePatch": {"font": {"body": "x; } body { display: none"}}, "renderError": {"code": "E_THEME", "key": "font.body"}},
  {"name": "theme: unitless breakpoint", "themePatch": {"breakpoint": "0"}, "renderError": {"code": "E_THEME", "key": "breakpoint"}},
  {"name": "theme: number instead of string", "themePatch": {"radius": 4}, "renderError": {"code": "E_THEME", "key": "radius"}},
  {"name": "theme: unknown top-level key", "themePatch": {"shadow": "none"}, "renderError": {"code": "E_THEME", "key": "shadow"}},
  {"name": "theme: empty array counts as an empty object (PHP cannot tell them apart)", "themePatch": {"space": []}, "renderError": {"code": "E_THEME", "key": "space.none"}},
  {"name": "theme: first problem wins in a fixed order", "themePatch": {"color": {"text": "bad"}, "space": {"sm": "bad"}}, "renderError": {"code": "E_THEME", "key": "space.sm"}}
