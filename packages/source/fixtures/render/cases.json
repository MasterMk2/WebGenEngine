  {
    "name": "typical page section",
    "source": "<!-- メモ -->\n<Section padding=\"xl\" background=\"subtle\" width=\"narrow\">\n  <Stack align=\"center\" gap=\"md\">\n    <Heading level=\"1\" align=\"center\">ようこそ</Heading>\n    <Text size=\"lg\">小さなお店の<Strong>公式サイト</Strong>です。<Link href=\"/about\">詳しく</Link><Br/>次の行</Text>\n    <Stack direction=\"horizontal\" gap=\"sm\">\n      <Button href=\"/contact\">お問い合わせ</Button>\n      <Button href=\"tel:0312345678\" variant=\"secondary\">電話</Button>\n    </Stack>\n  </Stack>\n</Section>\n",
    "html": "<section class=\"wge-section wge-padding-xl wge-bg-subtle wge-width-narrow\">\n  <div class=\"wge-stack wge-align-center wge-gap-md\">\n    <h1 class=\"wge-heading wge-text-align-center\">ようこそ</h1>\n    <p class=\"wge-text wge-size-lg\">小さなお店の<strong>公式サイト</strong>です。<a href=\"/about\">詳しく</a><br>次の行</p>\n    <div class=\"wge-stack wge-direction-horizontal wge-gap-sm\">\n      <a class=\"wge-button\" href=\"/contact\">お問い合わせ</a>\n      <a class=\"wge-button wge-variant-secondary\" href=\"tel:0312345678\">電話</a>\n    </div>\n  </div>\n</section>\n"
  },
  {
    "name": "grid, image ratio, raw HTML and an empty stack",
    "source": "<Grid columns=\"3\" gap=\"2xl\">\n  <Image src=\"/a.jpg\" alt=\"店内\" ratio=\"16:9\" />\n  <Html><iframe src=\"https://example.com/map\"></iframe>\n<p>2 行目</p></Html>\n  <Stack />\n</Grid>\n",
    "html": "<div class=\"wge-grid wge-columns-3 wge-gap-2xl\">\n  <img class=\"wge-image wge-ratio-16-9\" src=\"/a.jpg\" alt=\"店内\" loading=\"lazy\" decoding=\"async\">\n  <iframe src=\"https://example.com/map\"></iframe>\n<p>2 行目</p>\n  <div class=\"wge-stack\"></div>\n</div>\n"
  },
  {
    "name": "class order follows the schema, not the source",
    "source": "<Stack wrap=\"false\" gap=\"lg\" justify=\"between\" direction=\"horizontal\" />",
    "html": "<div class=\"wge-stack wge-direction-horizontal wge-justify-between wge-gap-lg wge-wrap-false\"></div>\n"
  },
  {
    "name": "special characters are escaped",
    "source": "<Text>A &amp; B &lt;x&gt; \"q\" 's'</Text>\n<Image src=\"/a?b=1&amp;c=2\" alt=\"&quot;引用&quot; &lt;3\" />\n",
    "html": "<p class=\"wge-text\">A &amp; B &lt;x&gt; \"q\" 's'</p>\n<img class=\"wge-image\" src=\"/a?b=1&amp;c=2\" alt=\"&quot;引用&quot; &lt;3\" loading=\"lazy\" decoding=\"async\">\n"
  },
  {
    "name": "comments are not published",
    "source": "<!-- a -->\n<Stack>\n  <!-- b -->\n</Stack>\n<!-- c -->\n",
    "html": "<div class=\"wge-stack\"></div>\n"
  },
  {
    "name": "heading levels choose the tag",
