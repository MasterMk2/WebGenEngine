  {
    "name": "Html: script elements are removed with their content",
    "source": "<Html><script>alert(1)</script><p>残る</p><SCRIPT type=\"module\">x()</SCRIPT ><script src=\"/a.js\" />y()<p>self-closing does not end a script</p></Html>\n",
    "html": "<p>残る</p>\n"
  },
  {
    "name": "Html: event handler attributes are removed",
    "source": "<Html><img src=\"/a.png\" alt=\"写真\" onerror=\"alert(1)\"><img src=x onerror=alert(1)><img/src=\"/b.png\"/ONLOAD=\"x()\"/alt='b'><p onclick=\"x()\" title=\"説明\">文</p></Html>\n",
    "html": "<img src=\"/a.png\" alt=\"写真\"><img src=\"x\"><img src=\"/b.png\" alt=\"b\"><p title=\"説明\">文</p>\n"
  },
  {
    "name": "Html: javascript: and other unsafe URLs are removed",
    "source": "<Html><a href=\"javascript:alert(1)\">a</a><a href=\"JaVaScRiPt:alert(1)\">b</a><a href=\"jav&#x09;ascript:alert(1)\">c</a><a href=\"&#106;avascript:alert(1)\">d</a><a href=\" javascript:alert(1)\">e</a><a href=\"vbscript:x\">f</a><img src=\"data:image/svg+xml,x\" alt=\"g\"><a href=\"java\nscript:x\">h</a></Html>\n",
    "html": "<a>a</a><a>b</a><a>c</a><a>d</a><a>e</a><a>f</a><img alt=\"g\"><a>h</a>\n"
  },
  {
    "name": "Html: allowed markup and safe URLs are kept as written",
    "source": "<Html><h2>お知らせ</h2>\n<p>営業は<strong>9 時</strong>から<br>土日は<em>休み</em>です&nbsp;&copy;</p>\n<ul><li><a href=\"https://example.com/?a=1&amp;b=2\" title=\"地図\">地図</a></li><li><a href=\"/menu#top\">メニュー</a></li><li><a href=\"tel:0312345678\">電話</a></li></ul>\n<table><tr><th scope=\"col\">品</th><td colspan=\"2\">珈琲</td></tr></table></Html>\n",
    "html": "<h2>お知らせ</h2>\n<p>営業は<strong>9 時</strong>から<br>土日は<em>休み</em>です&nbsp;&copy;</p>\n<ul><li><a href=\"https://example.com/?a=1&amp;b=2\" title=\"地図\">地図</a></li><li><a href=\"/menu#top\">メニュー</a></li><li><a href=\"tel:0312345678\">電話</a></li></ul>\n<table><tr><th scope=\"col\">品</th><td colspan=\"2\">珈琲</td></tr></table>\n"
  },
  {
