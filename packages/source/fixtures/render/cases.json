  {"name": "theme: named color", "themePatch": {"color": {"primary": "red"}}, "renderError": {"code": "E_THEME", "key": "color.primary"}},
  {"name": "theme: CSS injection through the font", "themePatch": {"font": {"body": "x; } body { display: none"}}, "renderError": {"code": "E_THEME", "key": "font.body"}},
  {"name": "theme: unitless breakpoint", "themePatch": {"breakpoint": "0"}, "renderError": {"code": "E_THEME", "key": "breakpoint"}},
