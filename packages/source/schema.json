{
  "version": 1,
  "tokens": {
    "space": ["none", "xs", "sm", "md", "lg", "xl", "2xl"]
  },
  "urlSchemes": ["http", "https", "mailto", "tel"],
  "embedSources": ["https://www.google.com/maps/embed?", "https://maps.google.com/maps?", "/"],
  "theme": {
    "color": ["text", "background", "subtle", "primary", "on-primary", "inverse", "on-inverse"],
    "fontSize": ["sm", "md", "lg"],
    "width": ["narrow", "normal", "wide"]
  },
  "components": [
    {
      "name": "Section",
      "kind": "container",
      "attributes": [
        { "name": "padding", "type": "space" },
        { "name": "background", "type": "enum", "values": ["none", "subtle", "primary", "inverse"] },
        { "name": "width", "type": "enum", "values": ["narrow", "normal", "wide", "full"] }
      ],
      "render": { "tag": "section", "class": "wge-section", "classes": ["padding", "background:bg", "width"] }
    },
    {
      "name": "Stack",
      "kind": "container",
      "attributes": [
        { "name": "direction", "type": "enum", "values": ["vertical", "horizontal"] },
        { "name": "align", "type": "enum", "values": ["start", "center", "end", "stretch"] },
        { "name": "justify", "type": "enum", "values": ["start", "center", "end", "between"] },
        { "name": "gap", "type": "space" },
        { "name": "wrap", "type": "enum", "values": ["true", "false"] },
        { "name": "surface", "type": "enum", "values": ["none", "card", "notice"] }
      ],
      "render": { "tag": "div", "class": "wge-stack", "classes": ["direction", "align", "justify", "gap", "wrap", "surface"] }
    },
    {
      "name": "Grid",
      "kind": "container",
      "attributes": [
        { "name": "columns", "type": "int", "min": 1, "max": 6, "required": true },
        { "name": "gap", "type": "space" }
      ],
      "render": { "tag": "div", "class": "wge-grid", "classes": ["columns", "gap"] }
    },
    {
      "name": "Heading",
      "kind": "text",
      "attributes": [
        { "name": "level", "type": "int", "min": 1, "max": 6, "required": true },
        { "name": "align", "type": "enum", "values": ["start", "center", "end"] }
      ],
      "render": { "tag": "h{level}", "class": "wge-heading", "classes": ["align:text-align"] }
    },
    {
      "name": "Text",
      "kind": "text",
      "attributes": [
        { "name": "size", "type": "enum", "values": ["sm", "md", "lg"] },
        { "name": "align", "type": "enum", "values": ["start", "center", "end"] }
      ],
      "render": { "tag": "p", "class": "wge-text", "classes": ["size", "align:text-align"] }
    },
    {
      "name": "Button",
      "kind": "text",
      "excludes": ["Link"],
      "attributes": [
        { "name": "href", "type": "url", "required": true },
        { "name": "variant", "type": "enum", "values": ["primary", "secondary"] }
      ],
      "render": { "tag": "a", "class": "wge-button", "classes": ["variant"], "attrs": ["href"] }
    },
    {
      "name": "Image",
      "kind": "void",
      "attributes": [
        { "name": "src", "type": "url", "required": true },
        { "name": "alt", "type": "string", "required": true },
        { "name": "ratio", "type": "enum", "values": ["auto", "1:1", "4:3", "16:9"] },
        { "name": "width", "type": "int", "min": 1, "max": 20000 },
        { "name": "height", "type": "int", "min": 1, "max": 20000 }
      ],
      "render": { "tag": "img", "class": "wge-image", "classes": ["ratio"], "attrs": ["src", "alt", "width", "height"], "fixed": [["loading", "lazy"], ["decoding", "async"]] }
    },
    {
      "name": "Embed",
      "kind": "void",
      "attributes": [
        { "name": "src", "type": "embed", "required": true },
        { "name": "title", "type": "string", "required": true },
        { "name": "ratio", "type": "enum", "values": ["16:9", "4:3", "1:1", "3:4"] }
      ],
      "render": { "tag": "iframe", "class": "wge-embed", "classes": ["ratio:embed-ratio"], "attrs": ["src", "title"], "fixed": [["loading", "lazy"]], "close": true },
      "preview": "placeholder"
    },
    {
      "name": "Table",
      "kind": "container",
      "children": ["Row"],
      "attributes": [],
      "render": { "tag": "table", "class": "wge-table", "inner": "tbody" }
    },
    {
      "name": "Row",
      "kind": "container",
      "parents": ["Table"],
      "children": ["HeaderCell", "Cell"],
      "attributes": [],
      "render": { "tag": "tr" }
    },
    {
      "name": "HeaderCell",
      "kind": "text",
      "parents": ["Row"],
      "attributes": [
        { "name": "scope", "type": "enum", "values": ["row", "col"] }
      ],
      "render": { "tag": "th", "attrs": ["scope"] }
    },
    {
      "name": "Cell",
      "kind": "text",
      "parents": ["Row"],
      "attributes": [],
      "render": { "tag": "td" }
    },
    {
      "name": "Html",
      "kind": "raw",
      "trusted": true,
      "attributes": [],
      "sanitize": {
        "elements": {
          "a": ["href"], "abbr": [], "b": [], "blockquote": ["cite"], "br": [], "caption": [], "cite": [], "code": [],
          "dd": [], "del": ["cite"], "div": [], "dl": [], "dt": [], "em": [], "figcaption": [], "figure": [],
          "h1": [], "h2": [], "h3": [], "h4": [], "h5": [], "h6": [], "hr": [], "i": [],
          "img": ["src", "alt", "width", "height"], "ins": ["cite"], "kbd": [], "li": [], "mark": [], "ol": ["start"],
          "p": [], "pre": [], "q": ["cite"], "s": [], "small": [], "span": [], "strong": [], "sub": [], "sup": [],
          "table": [], "tbody": [], "td": ["colspan", "rowspan"], "tfoot": [], "th": ["colspan", "rowspan", "scope"],
          "thead": [], "tr": [], "u": [], "ul": []
        },
        "globalAttributes": ["title"],
        "urlAttributes": ["href", "src", "cite"],
        "void": ["br", "hr", "img"],
        "dropContent": ["script", "style", "template", "iframe", "object", "noscript", "textarea", "title", "xmp", "noembed", "noframes", "plaintext", "svg", "math"]
      }
    },
    {
      "name": "Link",
      "kind": "inline",
      "excludes": ["Link"],
      "attributes": [
        { "name": "href", "type": "url", "required": true }
      ],
      "render": { "tag": "a", "attrs": ["href"] }
    },
    { "name": "Strong", "kind": "inline", "attributes": [], "render": { "tag": "strong" } },
    { "name": "Em", "kind": "inline", "attributes": [], "render": { "tag": "em" } },
    { "name": "Small", "kind": "inline", "attributes": [], "render": { "tag": "small" } },
    { "name": "Br", "kind": "inline-void", "attributes": [], "render": { "tag": "br" } }
  ]
}
